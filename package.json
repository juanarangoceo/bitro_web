{
  "name": "nitro-web",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma multiempresa para crear, personalizar, publicar y medir landing pages de una sola oferta",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "dev:renderer": "pnpm --filter @nitro-web/renderer dev",
    "dev:dashboard": "pnpm --filter @nitro-web/dashboard dev",
    "build": "pnpm -r --filter './packages/*' build && pnpm -r --filter './apps/*' build",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p scripts",
    "lint": "pnpm -r lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed-template": "tsx scripts/seed-template.ts",
    "db:seed-site": "tsx scripts/seed-site.ts",
    "db:seed-assets": "tsx scripts/seed-assets.ts",
    "db:publish-site": "tsx scripts/publish-site.ts",
    "db:seed-domain": "tsx scripts/seed-domain.ts"
  },
  "devDependencies": {
    "@nitro-web/contracts": "workspace:*",
    "@nitro-web/db": "workspace:*",
    "@nitro-web/shared": "workspace:*",
    "@nitro-web/templates": "workspace:*",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
