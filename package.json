{
  "name": "nitro-web",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma multiempresa para crear, personalizar, publicar y medir landing pages de una sola oferta",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "dev:renderer": "pnpm --filter @nitro-web/renderer dev",
    "dev:dashboard": "pnpm --filter @nitro-web/dashboard dev",
    "build": "pnpm -r --filter './packages/*' build && pnpm -r --filter './apps/*' build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:diff": "node scripts/db-status.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
