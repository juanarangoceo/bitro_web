# ---------------------------------------------------------------------------
# Nitro Web — variables de entorno
#
# Copiar como .env.local y completar. NUNCA poner un valor secreto en una
# variable con prefijo NEXT_PUBLIC_: ese prefijo la incrusta en el bundle del
# navegador. Ver docs/ENTORNO.md.
# ---------------------------------------------------------------------------

# --- Supabase (proyecto PROPIO de Nitro Web, nunca el de Nitro Bot) ---
# Públicas: viajan al navegador por diseño.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secreta: solo en el dashboard, solo en servidor. Omite RLS.
SUPABASE_SECRET_KEY=

# --- IA (solo dashboard) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Vercel: gestión de dominios (solo dashboard) ---
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_RENDERER_PROJECT_ID=

# --- Dominios ---
# Dominio operativo compartido donde viven los subdominios de clientes.
# DEBE ser distinto del dominio corporativo (§12.4).
NITRO_WEB_ROOT_DOMAIN=nitrolanding.co
NITRO_WEB_CORPORATE_DOMAIN=

# --- Pedidos ---
# Plantilla por defecto del mensaje de WhatsApp. Marcadores: {customerName},
# {offerTitle}, {total}, {city}, {orderNumber}.
WHATSAPP_TEMPLATE_DEFAULT=

# --- Correo transaccional (proveedor por definir, ver DECISIONES-PENDIENTES) ---
EMAIL_PROVIDER_KEY=

# --- Suscripciones SaaS (v1, no piloto) ---
BILLING_PROVIDER_KEY=

# --- Desarrollo local ---
# En local no hay hostnames reales. Fija el site que sirve el renderer en
# localhost. Se ignora cuando NODE_ENV=production.
NITRO_WEB_DEV_SITE_ID=
